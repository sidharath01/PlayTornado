@@ -0,0 +1,61 @@
+import 'package:flutter/material.dart';
+
+import '../../utils/tv/tv_mode.dart';
+
+/// Small floating button (phones/tablets only) that switches the screen
+/// sensor between AUTO (all 4 directions) and LOCKED (current orientation).
+class OrientationToggleOverlay extends StatefulWidget {
+  const OrientationToggleOverlay({super.key, required this.child});
+
+  final Widget child;
+
+  @override
+  State<OrientationToggleOverlay> createState() => _OrientationToggleOverlayState();
+}
+
+class _OrientationToggleOverlayState extends State<OrientationToggleOverlay> {
+  Future<void> _toggle() async {
+    final orientation = MediaQuery.of(context).orientation;
+    await TvMode.setSensorOn(!TvMode.sensorOn, current: orientation);
+    if (mounted) setState(() {});
+  }
+
+  @override
+  Widget build(BuildContext context) {
+    if (TvMode.isTv) return widget.child;
+    return Directionality(
+      textDirection: TextDirection.ltr,
+      child: Stack(
+        children: [
+          widget.child,
+          Positioned(
+            right: 0,
+            top: 0,
+            bottom: 0,
+            child: Center(
+              child: GestureDetector(
+                behavior: HitTestBehavior.opaque,
+                onTap: _toggle,
+                child: Opacity(
+                  opacity: 0.55,
+                  child: Container(
+                    padding: const EdgeInsets.symmetric(horizontal: 8, vertical: 10),
+                    decoration: const BoxDecoration(
+                      color: Color(0xCC000000),
+                      borderRadius: BorderRadius.horizontal(left: Radius.circular(12)),
+                    ),
+                    child: Icon(
+                      TvMode.sensorOn ? Icons.screen_rotation : Icons.screen_lock_rotation,
+                      color: Colors.white,
+                      size: 20,
+                    ),
+                  ),
+                ),
+              ),
+            ),
+          ),
+        ],
+      ),
+    );
+  }
+}
diff --git a/lib/widgets/common/tv_focusable.dart b/lib/widgets/common/tv_focusable.dart
new file mode 100644
index 0000000..770651d
--- /dev/null
+++ b/lib/widgets/common/tv_focusable.dart
@@ -0,0 +1,219 @@
+import 'package:flutter/material.dart';
+import 'package:flutter/services.dart';
+
+/// Focus highlight colour used everywhere for remote / D-pad navigation.
+const Color kTvFocusBlue = Color(0xFF2979FF);
+
+/// Makes any widget reachable with a D-pad / remote.
+///
+///  * Arrow keys move focus (Flutter's directional traversal).
+///  * OK / Select / Enter / Gamepad-A  -> [onTap]
+///  * Hold OK, or press Menu / Gamepad-X -> [onLongPress]
+///  * Focused: blue overlay fading from 0 to 50 % opacity + solid blue border.
+///  * [selected]: persistent blue tint, border and a check badge (selection mode).
+///
+/// Touch input is untouched: put the real tap handling on the child as before
+/// and pass the same callbacks here for key activation.
+class TvFocusable extends StatefulWidget {
+  const TvFocusable({
+    super.key,
+    required this.child,
+    this.onTap,
+    this.onLongPress,
+    this.radius = 16,
+    this.autofocus = false,
+    this.selected = false,
+    this.focusNode,
+  });
+
+  final Widget child;
+  final VoidCallback? onTap;
+  final VoidCallback? onLongPress;
+  final double radius;
+  final bool autofocus;
+  final bool selected;
+  final FocusNode? focusNode;
+
+  @override
+  State<TvFocusable> createState() => _TvFocusableState();
+}
+
+class _TvFocusableState extends State<TvFocusable> {
+  FocusNode? _ownNode;
+  bool _focused = false;
+  bool _keyDown = false;
+  bool _holdFired = false;
+
+  FocusNode get _node => widget.focusNode ?? (_ownNode ??= FocusNode(debugLabel: 'TvFocusable'));
+
+  @override
+  void initState() {
+    super.initState();
+    _node.addListener(_refresh);
+    FocusManager.instance.addHighlightModeListener(_onHighlightMode);
+  }
+
+  @override
+  void didUpdateWidget(covariant TvFocusable oldWidget) {
+    super.didUpdateWidget(oldWidget);
+    if (oldWidget.focusNode != widget.focusNode) {
+      (oldWidget.focusNode ?? _ownNode)?.removeListener(_refresh);
+      _node.addListener(_refresh);
+    }
+  }
+
+  @override
+  void dispose() {
+    FocusManager.instance.removeHighlightModeListener(_onHighlightMode);
+    _node.removeListener(_refresh);
+    _ownNode?.dispose();
+    super.dispose();
+  }
+
+  void _onHighlightMode(FocusHighlightMode mode) => _refresh();
+
+  void _refresh() {
+    if (!mounted) return;
+    final f = _node.hasFocus;
+    if (f != _focused) {
+      setState(() => _focused = f);
+    } else {
+      setState(() {});
+    }
+  }
+
+  bool get _showHighlight =>
+      _focused && FocusManager.instance.highlightMode == FocusHighlightMode.traditional;
+
+  KeyEventResult _onKey(FocusNode node, KeyEvent event) {
+    final k = event.logicalKey;
+    final isOk = k == LogicalKeyboardKey.select ||
+        k == LogicalKeyboardKey.enter ||
+        k == LogicalKeyboardKey.numpadEnter ||
+        k == LogicalKeyboardKey.gameButtonA;
+    final isMenu = k == LogicalKeyboardKey.contextMenu || k == LogicalKeyboardKey.gameButtonX;
+
+    if (isMenu) {
+      if (event is KeyDownEvent && widget.onLongPress != null) {
+        widget.onLongPress!();
+        return KeyEventResult.handled;
+      }
+      return KeyEventResult.ignored;
+    }
+    if (!isOk) return KeyEventResult.ignored;
+
+    if (event is KeyDownEvent) {
+      _keyDown = true;
+      _holdFired = false;
+      return KeyEventResult.handled;
+    }
+    if (event is KeyRepeatEvent) {
+      if (_keyDown && !_holdFired && widget.onLongPress != null) {
+        _holdFired = true;
+        widget.onLongPress!();
+      }
+      return KeyEventResult.handled;
+    }
+    if (event is KeyUpEvent) {
+      final fire = _keyDown && !_holdFired;
+      _keyDown = false;
+      _holdFired = false;
+      if (fire) widget.onTap?.call();
+      return KeyEventResult.handled;
+    }
+    return KeyEventResult.ignored;
+  }
+
+  @override
+  Widget build(BuildContext context) {
+    final show = _showHighlight;
+    final sel = widget.selected;
+    final radius = BorderRadius.circular(widget.radius);
+
+    final Color fill = sel
+        ? kTvFocusBlue.withValues(alpha: show ? 0.55 : 0.35)
+        : kTvFocusBlue.withValues(alpha: show ? 0.5 : 0.0);
+    final Color border = (show || sel) ? kTvFocusBlue : Colors.transparent;
+
+    return Focus(
+      focusNode: _node,
+      autofocus: widget.autofocus,
+      onKeyEvent: _onKey,
+      child: AnimatedScale(
+        scale: show ? 1.04 : 1.0,
+        duration: const Duration(milliseconds: 140),
+        curve: Curves.easeOutCubic,
+        child: Stack(
+          fit: StackFit.passthrough,
+          clipBehavior: Clip.none,
+          children: [
+            widget.child,
+            Positioned.fill(
+              child: IgnorePointer(
+                child: AnimatedContainer(
+                  duration: const Duration(milliseconds: 160),
+                  curve: Curves.easeOut,
+                  decoration: BoxDecoration(
+                    color: fill,
+                    borderRadius: radius,
+                    border: Border.all(color: border, width: 3),
+                  ),
+                ),
+              ),
+            ),
+            if (sel)
+              Positioned(
+                top: 8,
+                left: 8,
+                child: IgnorePointer(
+                  child: Container(
+                    width: 26,
+                    height: 26,
+                    decoration: const BoxDecoration(
+                      color: kTvFocusBlue,
+                      shape: BoxShape.circle,
+                    ),
+                    child: const Icon(Icons.check_rounded, size: 18, color: Colors.white),
+                  ),
+                ),
+              ),
+          ],
+        ),
+      ),
+    );
+  }
+}
+
+/// Drop-in replacement for a simple `GestureDetector(onTap/onLongPress/child)`
+/// that is also reachable and activatable with a remote / D-pad.
+class TvTap extends StatelessWidget {
+  const TvTap({
+    super.key,
+    this.onTap,
+    this.onLongPress,
+    this.behavior,
+    this.radius = 12,
+    required this.child,
+  });
+
+  final VoidCallback? onTap;
+  final VoidCallback? onLongPress;
+  final HitTestBehavior? behavior;
+  final double radius;
+  final Widget child;
+
+  @override
+  Widget build(BuildContext context) {
+    return TvFocusable(
+      radius: radius,
+      onTap: onTap,
+      onLongPress: onLongPress,
+      child: GestureDetector(
+        behavior: behavior,
+        onTap: onTap,
+        onLongPress: onLongPress,
+        child: child,
+      ),
+    );
+  }
+}
