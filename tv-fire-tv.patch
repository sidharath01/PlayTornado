diff --git a/lib/utils/tv/tv_mode.dart b/lib/utils/tv/tv_mode.dart
new file mode 100644
index 0000000..3f8cef3
--- /dev/null
+++ b/lib/utils/tv/tv_mode.dart
@@ -0,0 +1,59 @@
+import 'dart:io';
+
+import 'package:flutter/widgets.dart' show Orientation;
+import 'package:flutter/services.dart';
+import 'package:shared_preferences/shared_preferences.dart';
+
+/// TV detection + app-wide orientation policy.
+///
+///  * Fire TV / Android TV  -> always landscape.
+///  * Phones / tablets      -> sensor ON  = all 4 directions,
+///                             sensor OFF = locked to the orientation it was in.
+class TvMode {
+  TvMode._();
+
+  static const MethodChannel _channel = MethodChannel('com.example.playtorrio/power');
+  static const String _prefKey = 'rotate_sensor_on';
+
+  static bool isTv = false;
+  static bool sensorOn = true;
+  static List<DeviceOrientation> lockedOrientations = const [DeviceOrientation.portraitUp];
+
+  static Future<void> init() async {
+    if (Platform.isAndroid) {
+      try {
+        isTv = (await _channel.invokeMethod<bool>('isTv')) ?? false;
+      } catch (_) {
+        isTv = false;
+      }
+    }
+    try {
+      final prefs = await SharedPreferences.getInstance();
+      sensorOn = prefs.getBool(_prefKey) ?? true;
+    } catch (_) {}
+  }
+
+  static Future<void> setSensorOn(bool value, {Orientation? current}) async {
+    sensorOn = value;
+    if (!value) {
+      lockedOrientations = current == Orientation.landscape
+          ? const [DeviceOrientation.landscapeLeft, DeviceOrientation.landscapeRight]
+          : const [DeviceOrientation.portraitUp];
+    }
+    try {
+      final prefs = await SharedPreferences.getInstance();
+      await prefs.setBool(_prefKey, value);
+    } catch (_) {}
+    await applyOrientations();
+  }
+
+  /// Orientations the app should use when no screen forces its own.
+  static List<DeviceOrientation> get appOrientations {
+    if (isTv) {
+      return const [DeviceOrientation.landscapeLeft, DeviceOrientation.landscapeRight];
+    }
+    return sensorOn ? DeviceOrientation.values : lockedOrientations;
+  }
+
+  static Future<void> applyOrientations() => SystemChrome.setPreferredOrientations(appOrientations);
+}
